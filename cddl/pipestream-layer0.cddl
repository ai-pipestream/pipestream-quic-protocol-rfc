; PipeStream Core serialized-message schema. The historical filename is kept
; so existing Layer 0 conformance commands remain stable.
; This file is the machine-readable counterpart of Appendix C in
; draft-krickert-pipestream. The conformance suite verifies that the definitions
; remain synchronized with the draft source.

pipestream-message = pipestream-layer0-message / claim-redemption-frame
pipestream-layer0-message = capabilities / entity-header / checkpoint-frame

uint32 = 0..4294967295
entity-id = 1..4294967292

serialization-format = uint .le 255

extension-id = 1..65534
extension-list = [0*32 extension-id]

capabilities = {
  layer0-core: bool,
  layer1-recursive: bool,
  layer2-resilience: bool,
  ? max-scope-depth: uint .le 7,
  ? max-entities-per-scope: uint .le 4294967292,
  ? max-window-size: uint .le 2147483646,
  ? serialization-format: serialization-format,
  ? keepalive-timeout-ms: uint,
  ? supported-extensions: extension-list,
  ? required-extensions: extension-list,
}

entity-header = {
  entity-id: entity-id,
  ? parent-id: entity-id,
  ? scope-id: uint32,
  ? parent-scope-id: uint32,
  layer: uint .le 3,
  ? content-type: tstr,
  ? payload-length: uint,
  ? checksum: bstr .size 32,
  ? metadata: { * tstr => tstr },
  ? chunk-info: chunk-info,
  ? completion-policy: completion-policy,
}

chunk-info = {
  total-chunks: uint,
  chunk-index: uint,
  chunk-offset: uint,
}

completion-policy = {
  ? mode: completion-mode,
  ? max-retries: uint,
  ? retry-delay-ms: uint,
  ? timeout-ms: uint,
  ? min-success-ratio: float16 / float32,
  ? on-timeout: failure-action,
  ? on-failure: failure-action,
}

completion-mode = &(unspecified: 0, strict: 1, lenient: 2, best-effort: 3, quorum: 4)
failure-action = &(unspecified: 0, fail: 1, skip: 2, retry: 3, defer: 4)

checkpoint-frame = {
  checkpoint-id: tstr,
  sequence-number: uint,
  checkpoint-entity-id: entity-id,
  ? scope-id: uint32,
  ? flags: checkpoint-flags,
  ? timeout-ms: uint,
}

checkpoint-flags = uint .le 1

claim-redemption-frame = {
  flags: claim-redemption-flags,
  claim-id: uint .gt 0,
  session-id: tstr,
  state-checksum: bstr .size 32,
}

claim-redemption-flags = uint .le 1
