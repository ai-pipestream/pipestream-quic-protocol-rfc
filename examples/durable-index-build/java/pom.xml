<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.pipestream.examples</groupId>
  <artifactId>durable-index-build</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>PipeStream durable index-build example</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <netty.version>4.2.17.Final</netty.version>
    <pipestream.transport.version>4.2.17.Final-pipestream.3</pipestream.transport.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Local reality: the source-pinned fork build produced .3; the
        module pom names .4. Revisit when .4 is published. -->
      <dependency>
        <groupId>ai.pipestream.transport</groupId>
        <artifactId>netty-codec-classes-quic</artifactId>
        <version>${pipestream.transport.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.pipestream.transport</groupId>
        <artifactId>netty-codec-native-quic</artifactId>
        <version>${pipestream.transport.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.pipestream.transport</groupId>
        <artifactId>netty-codec-native-quic</artifactId>
        <version>${pipestream.transport.version}</version>
        <classifier>linux-x86_64</classifier>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>ai.pipestream</groupId>
      <artifactId>pipestream-quic-netty</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>ai.pipestream.examples.index.IndexMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
