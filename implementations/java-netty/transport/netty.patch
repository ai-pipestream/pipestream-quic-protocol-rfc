+package io.netty.handler.codec.quic;
+
+import static io.netty.util.internal.ObjectUtil.checkPositiveOrZero;
+
+/**
+ * Immutable connection-wide limits on native stream-data send admission.
+ * Ordinary streams can admit data while the aggregate retained stream-data span is below
+ * {@code total - reserved}. Streams explicitly marked with
+ * {@link QuicChannelOption#USE_RESERVED_SEND_BUFFER} can use the full total.
+ *
+ * <p>The charge is bytes written after each live stream's highest contiguous ACK offset.
+ * ACKed data behind an earlier gap remains charged; local write completion does not release it.
+ * Reset releases cleared send buffers. This is not an allocation or process-memory bound:
+ * application queues, QUIC metadata, TLS, datagrams and partially ACKed backing-buffer
+ * prefixes must be bounded separately. The native copying path can retain one such prefix
+ * of up to 4095 bytes per live send stream.</p>
+ *
+ * <p>These limits reserve local stream-data admission only, not network delivery, congestion
+ * capacity or peer flow-control credit. Applications still need control deadlines and bounded
+ * queues. Configure this option before registering the connection channel.</p>
+ */
+public final class QuicStreamSendBufferLimits {
+    private final long total;
+    private final long reserved;
+
+    /**
+     * Creates send admission limits.
+     *
+     * @param total total retained stream-data span allowed, in bytes.
+     * @param reserved portion inaccessible to ordinary streams, in bytes.
+     */
+    public QuicStreamSendBufferLimits(long total, long reserved) {
+        this.total = checkPositiveOrZero(total, "total");
+        this.reserved = checkPositiveOrZero(reserved, "reserved");
+        if (reserved > total) {
+            throw new IllegalArgumentException("reserved exceeds total");
+        }
+    }
+
+    /**
+     * Returns the total retained stream-data limit.
+     * @return the total in bytes.
+     */
+    public long total() {
+        return total;
+    }
+
+    /**
+     * Returns the portion reserved for explicitly selected streams.
+     * @return the reserved portion in bytes.
+     */
+    public long reserved() {
+        return reserved;
+    }
+
+    long available(long retained, boolean useReserved) {
+        long limit = useReserved ? total : total - reserved;
+        return retained < 0 || retained >= limit ? 0 : limit - retained;
+    }
+}
