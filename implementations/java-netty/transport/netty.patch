+        final AtomicReference<Throwable> failure = new AtomicReference<>();
+        final AtomicLong expectedResetStream = new AtomicLong(-1);
+        final AtomicLong expectedResetCode = new AtomicLong(-1);
+        final CountDownLatch expectedResetObserved = new CountDownLatch(1);
+        final BlockingQueue<QuicStreamChannel> serverStreams = new LinkedBlockingQueue<>();
+        final ConcurrentMap<Long, CopyOnWriteArrayList<Byte>> receivedByStream = new ConcurrentHashMap<>();
+        final Channel server;
+        final Channel clientDatagram;
+        final QuicChannel client;
