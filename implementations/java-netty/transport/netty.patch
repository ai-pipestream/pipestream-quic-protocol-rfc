+        Fixture(Executor executor, QuicStreamSendBufferLimits limits) throws Exception {
+            ChannelInboundHandlerAdapter streamHandler = new ChannelInboundHandlerAdapter() {
+                @Override
+                public boolean isSharable() {
+                    return true;
+                }
+
+                @Override
+                public void channelActive(ChannelHandlerContext ctx) {
+                    serverStreams.add((QuicStreamChannel) ctx.channel());
+                    ctx.fireChannelActive();
+                }
+
+                @Override
+                public void channelRead(ChannelHandlerContext ctx, Object msg) {
+                    ByteBuf buffer = (ByteBuf) msg;
+                    receivedBytes.addAndGet(buffer.readableBytes());
+                    CopyOnWriteArrayList<Byte> bytes = receivedByStream.computeIfAbsent(
+                            ((QuicStreamChannel) ctx.channel()).streamId(), key -> new CopyOnWriteArrayList<>());
+                    while (buffer.isReadable()) {
+                        bytes.add(buffer.readByte());
+                    }
+                    buffer.release();
+                }
+
+                @Override
+                public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) {
+                    if (cause instanceof QuicStreamResetException &&
+                            ((QuicStreamChannel) ctx.channel()).streamId() == expectedResetStream.get() &&
+                            ((QuicStreamResetException) cause).applicationProtocolCode() == expectedResetCode.get()) {
+                        expectedResetObserved.countDown();
+                        return;
+                    }
+                    failure.compareAndSet(null, cause);
+                    ctx.close();
+                }
+
+                @Override
+                public void userEventTriggered(ChannelHandlerContext ctx, Object evt) {
+                    if (evt instanceof ChannelInputShutdownEvent) {
+                        inputShutdowns.incrementAndGet();
+                    }
+                    ctx.fireUserEventTriggered(evt);
+                }
+            };
+            server = QuicTestUtils.newServer(executor, new ChannelInboundHandlerAdapter(), streamHandler);
+            server.pipeline().addFirst(new ChannelDuplexHandler() {
+                @Override
+                public void write(ChannelHandlerContext ctx, Object msg, ChannelPromise promise) {
+                    if (dropServerPackets.get()) {
+                        ReferenceCountUtil.release(msg);
+                        promise.setSuccess();
+                    } else {
+                        ctx.write(msg, promise);
+                    }
+                }
+
+                @Override
+                public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) {
