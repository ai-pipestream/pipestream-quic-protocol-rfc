+package io.netty.handler.codec.quic;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class QuicStreamSendBufferLimitsTest {
+
+    @Test
+    void validatesAndExposesLimits() {
+        QuicStreamSendBufferLimits limits = new QuicStreamSendBufferLimits(17, 5);
+
+        assertThat(limits.total()).isEqualTo(17);
+        assertThat(limits.reserved()).isEqualTo(5);
+        assertThatThrownBy(() -> new QuicStreamSendBufferLimits(-1, 0))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new QuicStreamSendBufferLimits(1, -1))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new QuicStreamSendBufferLimits(1, 2))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void computesOrdinaryAndReservedAllowancesWithoutOverflow() {
+        QuicStreamSendBufferLimits limits = new QuicStreamSendBufferLimits(17, 5);
+
+        assertThat(limits.available(0, false)).isEqualTo(12);
+        assertThat(limits.available(0, true)).isEqualTo(17);
+        assertThat(limits.available(12, false)).isZero();
+        assertThat(limits.available(12, true)).isEqualTo(5);
+        assertThat(limits.available(17, true)).isZero();
+        assertThat(limits.available(18, false)).isZero();
+        assertThat(limits.available(Long.MAX_VALUE, true)).isZero();
+
+        QuicStreamSendBufferLimits zero = new QuicStreamSendBufferLimits(0, 0);
+        assertThat(zero.available(0, false)).isZero();
+        assertThat(zero.available(0, true)).isZero();
+
+        QuicStreamSendBufferLimits maximum = new QuicStreamSendBufferLimits(Long.MAX_VALUE, 0);
+        assertThat(maximum.available(Long.MAX_VALUE - 1, false)).isEqualTo(1);
+    }
+}
