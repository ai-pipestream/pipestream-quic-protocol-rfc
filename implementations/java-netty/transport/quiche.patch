+#[test]
+fn configured_connection_window_replenishes_without_increasing_initial_max_data()
+{
+    let mut config = Config::new(PROTOCOL_VERSION).unwrap();
+    config
+        .load_cert_chain_from_pem_file("examples/cert.crt")
+        .unwrap();
+    config
+        .load_priv_key_from_pem_file("examples/cert.key")
+        .unwrap();
+    config.set_application_protos(&[b"proto1"]).unwrap();
+    config.set_initial_max_data(30);
+    config.set_initial_connection_window(100);
+    config.set_max_connection_window(100);
+    config.set_initial_max_stream_data_bidi_local(200);
+    config.set_initial_max_stream_data_bidi_remote(200);
+    config.set_initial_max_streams_bidi(1);
+    config.verify_peer(false);
+
+    let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+    assert_eq!(pipe.handshake(), Ok(()));
+    assert_eq!(pipe.server.local_transport_params.initial_max_data, 30);
+    assert_eq!(pipe.server.flow_control.max_data(), 30);
+    assert_eq!(pipe.server.flow_control.window(), 100);
+
+    assert_eq!(pipe.client.stream_send(0, &[1; 30], false), Ok(30));
+    assert_eq!(pipe.advance(), Ok(()));
+    let mut read = [0; 20];
+    assert_eq!(pipe.server.stream_recv(0, &mut read), Ok((20, false)));
+
+    let flight = test_utils::emit_flight(&mut pipe.server).unwrap();
+    test_utils::process_flight(&mut pipe.client, flight).unwrap();
+    assert_eq!(pipe.client.max_tx_data, 120);
+    assert_eq!(pipe.server.flow_control.window(), 100);
+
+    // A second prompt update cannot autotune past the configured maximum.
+    assert_eq!(pipe.client.stream_send(0, &[2; 60], false), Ok(60));
+    assert_eq!(pipe.advance(), Ok(()));
+    let mut read = [0; 60];
+    assert_eq!(pipe.server.stream_recv(0, &mut read), Ok((60, false)));
+    let flight = test_utils::emit_flight(&mut pipe.server).unwrap();
+    test_utils::process_flight(&mut pipe.client, flight).unwrap();
+    assert_eq!(pipe.server.flow_control.window(), 100);
+    assert_eq!(pipe.client.max_tx_data, 180);
+}
