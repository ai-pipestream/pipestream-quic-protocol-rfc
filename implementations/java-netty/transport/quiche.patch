+#[test]
+fn stream_send_retained_keeps_out_of_order_ack_holes_and_retransmissions() {
+    let mut pipe = retained_stream_pipe();
+    let mut buf = [0; 65535];
+    let first = pipe.client.next_pkt_num;
+
+    for data in [b"aaaa", b"bbbb", b"cccc", b"dddd"] {
+        assert_eq!(pipe.client.stream_send(4, data, false), Ok(4));
+        let (written, _) = pipe.client.send(&mut buf).unwrap();
+        assert!(written > 0);
+    }
+    let last = pipe.client.next_pkt_num - 1;
+    assert_eq!(pipe.client.stream_send_retained(), 16);
+
+    let mut ranges = ranges::RangeSet::default();
+    ranges.insert(last..last + 1);
+    let ack = frame::Frame::ACK {
+        ack_delay: 0,
+        ranges: ranges.clone(),
+        ecn_counts: None,
+    };
+    let written =
+        test_utils::encode_pkt(&mut pipe.server, Type::Short, &[ack], &mut buf)
+            .unwrap();
+    assert_eq!(pipe.client_recv(&mut buf[..written]), Ok(written));
+    assert_eq!(pipe.client.stream_send_retained(), 16);
+
+    // Packet-threshold loss makes earlier data eligible for retransmission,
+    // but retransmitting an existing offset span cannot charge it twice.
+    let (written, _) = pipe.client.send(&mut buf).unwrap();
+    assert!(written > 0);
+    let retransmitted =
