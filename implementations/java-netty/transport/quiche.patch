+    assert_eq!(pipe.client_recv(&mut buf[..written]), Ok(written));
+    assert_eq!(pipe.client.stream_send_retained(), 16);
+
+    let mut all = ranges::RangeSet::default();
+    all.insert(first..pipe.client.next_pkt_num);
+    let written = test_utils::encode_pkt(
