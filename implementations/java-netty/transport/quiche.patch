+#[test]
+fn paired_receive_credit_autotunes_connection_window_once_per_update() {
+    let mut config = paired_receive_credit_config();
+    config.set_initial_max_data(256);
+    config.set_initial_connection_window(128);
+    config.set_max_connection_window(1024);
+    config.set_initial_max_streams_uni(2);
+    let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+    assert_eq!(pipe.handshake(), Ok(()));
+
+    // Receive both streams before either update. The native packet builder's
+    // explicit time input then fixes the two updates inside one RTT without
+    // relying on host scheduling or injecting an unregistered packet.
+    assert_eq!(pipe.client.stream_send(2, &[0x5a; 128], false), Ok(128));
+    assert_eq!(pipe.client.stream_send(6, &[0x5a; 128], false), Ok(128));
+    let flight = test_utils::emit_flight(&mut pipe.client).unwrap();
+    test_utils::process_flight(&mut pipe.server, flight).unwrap();
+    let packet_time = Instant::now();
+    let active_pid = pipe.server.paths.get_active_path_id().unwrap();
+
+    for (stream_id, expected_max_data) in [(2, 320), (6, 640)] {
+        let mut data = [0; 128];
+        assert_eq!(pipe.server.stream_recv(stream_id, &mut data), Ok((128, false)));
+        assert_eq!(data, [0x5a; 128]);
+
+        let mut packet = [0; 1200];
+        let (ty, len) = pipe.server
+            .send_single(&mut packet, active_pid, false, packet_time)
+            .unwrap();
+        assert_eq!(ty, Type::Short);
+        let mut inspection = packet[..len].to_vec();
+        let frames = test_utils::decode_pkt(&mut pipe.client, &mut inspection).unwrap();
+        assert!(frames.iter().any(|frame| {
+            matches!(frame, frame::Frame::MaxStreamData { stream_id: id, .. } if *id == stream_id)
+        }));
+        assert!(frames.iter().any(|frame| {
+            matches!(frame, frame::Frame::MaxData { max } if *max == expected_max_data)
+        }));
+        assert_eq!(pipe.client_recv(&mut packet[..len]), Ok(len));
+    }
+    assert_eq!(pipe.server.flow_control.window(), 384);
+}
