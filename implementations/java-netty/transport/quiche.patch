+#[test]
+fn stream_send_retained_counts_live_stream_offset_spans_until_ack() {
+    let mut pipe = retained_stream_pipe();
+
+    assert_eq!(pipe.client.stream_send(4, b"hello", false), Ok(5));
+    assert_eq!(pipe.client.stream_send(8, b"goodbye", true), Ok(7));
+    assert_eq!(pipe.client.stream_send_retained(), 12);
+
+    let mut buf = [0; 65535];
+    let first = pipe.client.next_pkt_num;
+    let flight = test_utils::emit_flight(&mut pipe.client).unwrap();
+    assert!(!flight.is_empty());
+    assert_eq!(pipe.client.stream_send_retained(), 12);
+
+    let mut ranges = ranges::RangeSet::default();
+    ranges.insert(first..pipe.client.next_pkt_num);
+    let frames = [frame::Frame::ACK {
+        ack_delay: 0,
+        ranges,
+        ecn_counts: None,
+    }];
+    let written =
+        test_utils::encode_pkt(&mut pipe.server, Type::Short, &frames, &mut buf)
+            .unwrap();
+    assert_eq!(pipe.client_recv(&mut buf[..written]), Ok(written));
+    assert_eq!(pipe.client.stream_send_retained(), 0);
+}
+
