+    assert_eq!(pipe.client.stream_send(8, b"fin", true), Ok(3));
+    assert_eq!(pipe.client.stream_send_retained(), 3);
+    let first = pipe.client.next_pkt_num;
+    let (written, _) = pipe.client.send(&mut buf).unwrap();
+    assert!(written > 0);
+    assert_eq!(pipe.client.stream_send_retained(), 3);
