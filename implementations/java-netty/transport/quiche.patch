+    assert_eq!(pipe.client.stream_send(0, b"offer", false), Ok(5));
+    let (written, _) = pipe.client.send(&mut buf).unwrap();
+    assert_eq!(pipe.server_recv(&mut buf[..written]), Ok(written));
+    let mut received = [0; 16];
+    assert_eq!(pipe.server.stream_recv(0, &mut received), Ok((5, false)));
+    assert_eq!(&received[..5], b"offer");
+
+    assert_eq!(pipe.server.stream_send(0, b"capabilities", false), Ok(12));
+    let first = pipe.server.next_pkt_num;
+    let (written, _) = pipe.server.send(&mut buf).unwrap();
+    assert_eq!(pipe.client_recv(&mut buf[..written]), Ok(written));
+
+    let mut ranges = ranges::RangeSet::default();
+    ranges.insert(first..pipe.server.next_pkt_num);
+    let written = test_utils::encode_pkt(
+        &mut pipe.client,
+        Type::Short,
+        &[frame::Frame::ACK {
+            ack_delay: 0,
+            ranges,
+            ecn_counts: None,
+        }],
+        &mut buf,
