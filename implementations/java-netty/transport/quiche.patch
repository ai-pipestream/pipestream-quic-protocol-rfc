+#[test]
+fn late_empty_fin_is_emitted_after_payload_ack_and_peer_fin() {
+    let mut pipe = retained_stream_pipe();
+    let mut buf = [0; 65535];
+
+    assert_eq!(pipe.client.stream_send(0, b"offer", false), Ok(5));
+    let (written, _) = pipe.client.send(&mut buf).unwrap();
+    assert_eq!(pipe.server_recv(&mut buf[..written]), Ok(written));
+    let mut received = [0; 16];
+    assert_eq!(pipe.server.stream_recv(0, &mut received), Ok((5, false)));
+    assert_eq!(&received[..5], b"offer");
+
+    assert_eq!(pipe.server.stream_send(0, b"capabilities", false), Ok(12));
+    let first = pipe.server.next_pkt_num;
+    let (written, _) = pipe.server.send(&mut buf).unwrap();
+    assert_eq!(pipe.client_recv(&mut buf[..written]), Ok(written));
+
+    let mut ranges = ranges::RangeSet::default();
+    ranges.insert(first..pipe.server.next_pkt_num);
+    let written = test_utils::encode_pkt(
+        &mut pipe.client,
+        Type::Short,
+        &[frame::Frame::ACK {
+            ack_delay: 0,
+            ranges,
+            ecn_counts: None,
+        }],
+        &mut buf,
+    )
+    .unwrap();
+    assert_eq!(pipe.server_recv(&mut buf[..written]), Ok(written));
+    assert_eq!(pipe.server.stream_send_retained(), 0);
+
+    // Accept a late, empty local FIN but do not give packet_send() a chance
+    // to emit it before the peer's FIN arrives on the same stream.
+    assert_eq!(pipe.server.stream_send(0, b"", true), Ok(0));
+    assert_eq!(pipe.client.stream_send(0, b"", true), Ok(0));
+    let (written, _) = pipe.client.send(&mut buf).unwrap();
+    assert_eq!(pipe.server_recv(&mut buf[..written]), Ok(written));
+    assert_eq!(pipe.server.stream_recv(0, &mut received), Ok((0, true)));
+
+    let (written, _) = pipe.server.send(&mut buf).unwrap();
+    let frames =
+        test_utils::decode_pkt(&mut pipe.client, &mut buf[..written]).unwrap();
+    assert!(frames.iter().any(|frame| matches!(
+        frame,
+        frame::Frame::Stream { stream_id: 0, data }
+            if data.is_empty() && data.fin()
+    )));
+}
