+/// Pairs receive credit in one packet, or leaves both frames pending.
+/// A previously emitted packet is not proof that the peer received MAX_DATA.
+macro_rules! push_receive_credit_to_pkt {
+    ($out:expr, $frames:expr, $frame:expr, $left:expr, $flow:expr,
+     $now:expr, $enabled:expr, $paired_max:expr) => {{
+        let max = cmp::max($flow.max_data(), $flow.max_data_next());
+        if !$enabled || $paired_max.is_some_and(|sent| sent >= max) {
+            push_frame_to_pkt!($out, $frames, $frame, $left)
+        } else {
+            let connection_credit = frame::Frame::MaxData { max };
+            if connection_credit.wire_len() + $frame.wire_len() <= $left {
+                push_frame_to_pkt!($out, $frames, connection_credit, $left);
+
+                if $flow.max_data_next() > $flow.max_data() {
+                    $flow.update_max_data($now);
+                }
+                $paired_max = Some(max);
+
+                push_frame_to_pkt!($out, $frames, $frame, $left)
+            } else {
+                false
+            }
+        }
+    }};
+}
