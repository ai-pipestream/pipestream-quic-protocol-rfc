+#[test]
+fn delayed_max_data_diagnostic_exhausts_connection_before_control_stream_credit(
+) {
+    delayed_max_data_exhaustion_at_packet_size(39);
+}
+
+fn delayed_max_data_exhaustion_at_packet_size(packet_size: usize) {
+    const N: u64 = 1;
+    const W: u64 = 128;
+    const R: u64 = 2 * (N + 1) * W;
+
+    let mut config = Config::new(PROTOCOL_VERSION).unwrap();
+    config
+        .load_cert_chain_from_pem_file("examples/cert.crt")
+        .unwrap();
+    config
+        .load_priv_key_from_pem_file("examples/cert.key")
+        .unwrap();
+    config.set_application_protos(&[b"proto1"]).unwrap();
+    config.set_initial_max_data(R);
+    config.set_initial_connection_window(R);
+    config.set_max_connection_window(R);
+    config.set_max_stream_window(W);
+    config.set_initial_max_stream_data_bidi_local(W);
+    config.set_initial_max_stream_data_bidi_remote(W);
+    config.set_initial_max_stream_data_uni(W);
+    config.set_initial_max_streams_bidi(1);
+    config.set_initial_max_streams_uni(N);
+    config.verify_peer(false);
+
+    let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+    assert_eq!(pipe.handshake(), Ok(()));
+    let mut buf = [0; 65535];
+
+    // Open control stream 0 and leave its per-stream credit almost untouched.
+    assert_eq!(pipe.client.stream_send(0, b"c", false), Ok(1));
+    let (written, _) = pipe.client.send(&mut buf).unwrap();
+    assert_eq!(pipe.server_recv(&mut buf[..written]), Ok(written));
+    let mut control = [0; 1];
+    assert_eq!(pipe.server.stream_recv(0, &mut control), Ok((1, false)));
+
+    let mut sent = 0;
+    let mut observed_max_data = Vec::new();
+    let mut forwarded_ack = false;
+    let mut forwarded_stream_credit = false;
+    while sent < R - 1 {
+        let requested = cmp::min(W, R - 1 - sent) as usize;
+        assert_eq!(
+            pipe.client.stream_send(2, &vec![0x5a; requested], false),
+            Ok(requested)
+        );
+        let (written, _) = pipe.client.send(&mut buf).unwrap();
+        assert_eq!(pipe.server_recv(&mut buf[..written]), Ok(written));
+        let mut data = vec![0; requested];
+        assert_eq!(
+            pipe.server.stream_recv(2, &mut data),
+            Ok((requested, false))
+        );
+        assert!(data.iter().all(|byte| *byte == 0x5a));
+        sent += requested as u64;
+
+        let flight = test_utils::emit_flight_with_max_buffer(
+            &mut pipe.server,
+            packet_size,
+            None,
+            None,
+        )
+        .unwrap();
+        for (mut packet, info) in flight {
+            let mut inspection = packet.clone();
+            let frames = test_utils::decode_pkt(
+                &mut pipe.client,
+                &mut inspection,
+            )
+            .unwrap();
+            let has_max_data = frames.iter().any(|frame| {
+                if let frame::Frame::MaxData { max } = frame {
+                    observed_max_data.push(*max);
+                    true
+                } else {
+                    false
+                }
+            });
+            if has_max_data {
+                continue;
+            }
+            forwarded_ack |= frames
+                .iter()
+                .any(|frame| matches!(frame, frame::Frame::ACK { .. }));
+            forwarded_stream_credit |= frames.iter().any(|frame| {
+                matches!(frame, frame::Frame::MaxStreamData { stream_id: 2, .. })
+            });
+            test_utils::process_flight(
+                &mut pipe.client,
+                vec![(std::mem::take(&mut packet), info)],
+            )
+            .unwrap();
+        }
+    }
+
+    let control_stream_credit =
+        pipe.client.streams.get(0).unwrap().send.cap().unwrap();
+    assert_eq!(sent, R - 1);
+    assert!(!observed_max_data.is_empty());
+    assert!(forwarded_ack);
+    assert!(forwarded_stream_credit);
+    assert!(control_stream_credit >= (W - 1) as usize);
+    assert_eq!(pipe.client.stream_capacity(0), Ok(0));
+    assert_eq!(pipe.client.stream_send(0, b"x", false), Err(Error::Done));
+    println!(
+        "delayed MAX_DATA exhaustion packet_size={packet_size} sent={sent} \
+         initial_max_data={R} peer_max_data={} \
+         control_stream_credit={control_stream_credit} \
+         withheld_max_data={observed_max_data:?}",
+        pipe.client.max_tx_data,
+    );
+}
