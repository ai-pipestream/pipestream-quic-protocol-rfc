+        &[frame::Frame::ACK {
+            ack_delay: 0,
+            ranges,
+            ecn_counts: None,
+        }],
+        &mut buf,
+    )
+    .unwrap();
+    assert_eq!(pipe.client_recv(&mut buf[..written]), Ok(written));
+    assert_eq!(pipe.client.stream_send_retained(), 0);
+
+    assert_eq!(pipe.client.stream_send(12, b"", true), Ok(0));
+    assert_eq!(pipe.client.stream_send_retained(), 0);
