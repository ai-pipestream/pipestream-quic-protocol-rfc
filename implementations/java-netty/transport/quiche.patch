+fn paired_max_streams_uni_after_fin_and_reset_carries_connection_credit() {
+    for reset in [false, true] {
+        let mut config = paired_receive_credit_config();
+        let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+        assert_eq!(pipe.handshake(), Ok(()));
+
+        if reset {
+            assert_eq!(pipe.client.stream_send(2, b"x", false), Ok(1));
+            let data_flight =
+                test_utils::emit_flight(&mut pipe.client).unwrap();
+            test_utils::process_flight(&mut pipe.server, data_flight).unwrap();
+            pipe.client
+                .stream_shutdown(2, Shutdown::Write, 17)
+                .unwrap();
+            let reset_flight =
+                test_utils::emit_flight(&mut pipe.client).unwrap();
+            test_utils::process_flight(&mut pipe.server, reset_flight)
+                .unwrap();
+        } else {
+            assert_eq!(pipe.client.stream_send(2, b"x", true), Ok(1));
+            let flight = test_utils::emit_flight(&mut pipe.client).unwrap();
+            test_utils::process_flight(&mut pipe.server, flight).unwrap();
+        }
+        let mut data = [0; 1];
+        if reset {
+            assert_eq!(
+                pipe.server.stream_recv(2, &mut data),
+                Err(Error::StreamReset(17))
+            );
+        } else {
+            assert_eq!(pipe.server.stream_recv(2, &mut data), Ok((1, true)));
+            assert_eq!(data, *b"x");
+        }
+
+        let flight = test_utils::emit_flight(&mut pipe.server).unwrap();
+        let mut saw_replacement = false;
+        for (packet, info) in flight {
+            let mut inspection = packet.clone();
+            let frames =
+                test_utils::decode_pkt(&mut pipe.client, &mut inspection)
+                    .unwrap();
+            if frames
+                .iter()
+                .any(|frame| matches!(frame, frame::Frame::MaxStreamsUni { .. }))
+            {
+                saw_replacement = true;
+                assert!(frames.iter().any(|frame| {
+                    matches!(frame, frame::Frame::MaxData { max } if *max >= 513)
+                }));
+            }
+            test_utils::process_flight(&mut pipe.client, vec![(packet, info)])
+                .unwrap();
+        }
+        assert!(saw_replacement);
+        assert_eq!(pipe.client.peer_streams_left_uni(), 1);
+    }
