+fn paired_max_streams_uni_and_max_data_are_retransmitted_after_loss() {
+    let mut config = paired_receive_credit_config();
+    let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+    assert_eq!(pipe.handshake(), Ok(()));
+    assert_eq!(pipe.client.stream_send(2, b"x", true), Ok(1));
+    let flight = test_utils::emit_flight(&mut pipe.client).unwrap();
+    test_utils::process_flight(&mut pipe.server, flight).unwrap();
+    let mut data = [0; 1];
+    assert_eq!(pipe.server.stream_recv(2, &mut data), Ok((1, true)));
+
+    let dropped = test_utils::emit_flight(&mut pipe.server).unwrap();
+    let mut advertised_max_data = None;
+    for (mut packet, _) in dropped {
+        let frames =
+            test_utils::decode_pkt(&mut pipe.client, &mut packet).unwrap();
+        if frames
+            .iter()
+            .any(|frame| matches!(frame, frame::Frame::MaxStreamsUni { .. }))
+        {
+            advertised_max_data = frames.iter().find_map(|frame| match frame {
+                frame::Frame::MaxData { max } => Some(*max),
+                _ => None,
+            });
+        }
+    }
+    let advertised_max_data = advertised_max_data
+        .expect("dropped MAX_STREAMS_UNI lacked paired MAX_DATA");
+
+    let lost_before = pipe.server.stats().lost;
+    for _ in 0..4 {
+        pipe.server.send_ack_eliciting().unwrap();
+        let probe = test_utils::emit_flight(&mut pipe.server).unwrap();
+        test_utils::process_flight(&mut pipe.client, probe).unwrap();
+        let ack = test_utils::emit_flight(&mut pipe.client).unwrap();
+        test_utils::process_flight(&mut pipe.server, ack).unwrap();
+        if pipe.server.stats().lost > lost_before {
+            break;
+        }
+    }
+    assert!(pipe.server.stats().lost > lost_before);
+    let retransmission = test_utils::emit_flight(&mut pipe.server).unwrap();
+    let mut saw_replacement = false;
+    for (packet, info) in retransmission {
+        let mut inspection = packet.clone();
+        let frames =
+            test_utils::decode_pkt(&mut pipe.client, &mut inspection).unwrap();
+        if frames
+            .iter()
+            .any(|frame| matches!(frame, frame::Frame::MaxStreamsUni { .. }))
+        {
+            saw_replacement = true;
+            assert!(frames.iter().any(|frame| {
+                matches!(frame, frame::Frame::MaxData { max } if *max == advertised_max_data)
+            }));
+        }
+        test_utils::process_flight(&mut pipe.client, vec![(packet, info)])
+            .unwrap();
+    }
+    assert!(saw_replacement);
+    assert_eq!(pipe.client.peer_streams_left_uni(), 1);
+    assert_eq!(pipe.client.stream_send(6, b"r", false), Ok(1));
+}
