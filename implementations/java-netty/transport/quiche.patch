+#[test]
+fn paired_receive_credit_keeps_stream_and_connection_updates_in_one_packet() {
+    const W: u64 = 128;
+    const R: u64 = 512;
+
+    let mut config = Config::new(PROTOCOL_VERSION).unwrap();
+    config
+        .load_cert_chain_from_pem_file("examples/cert.crt")
+        .unwrap();
+    config
+        .load_priv_key_from_pem_file("examples/cert.key")
+        .unwrap();
+    config.set_application_protos(&[b"proto1"]).unwrap();
+    config.set_initial_max_data(R);
+    config.set_initial_connection_window(R);
+    config.set_max_connection_window(R);
+    config.set_max_stream_window(W);
+    config.set_initial_max_stream_data_bidi_local(W);
+    config.set_initial_max_stream_data_bidi_remote(W);
+    config.set_initial_max_stream_data_uni(W);
+    config.set_initial_max_streams_bidi(1);
+    config.set_initial_max_streams_uni(1);
+    config.set_pair_receive_credit(true);
+    config.verify_peer(false);
+
+    let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+    assert_eq!(pipe.handshake(), Ok(()));
+    assert_eq!(pipe.client.stream_send(0, b"c", false), Ok(1));
+    assert_eq!(pipe.client.stream_send(2, &[0x5a; 128], false), Ok(128));
+    let flight = test_utils::emit_flight(&mut pipe.client).unwrap();
+    test_utils::process_flight(&mut pipe.server, flight).unwrap();
+    let mut control = [0; 1];
+    assert_eq!(pipe.server.stream_recv(0, &mut control), Ok((1, false)));
+    let mut data = [0; 128];
+    assert_eq!(pipe.server.stream_recv(2, &mut data), Ok((128, false)));
+    assert_eq!(data, [0x5a; 128]);
+
+    let mut saw_stream_credit = false;
+    for _ in 0..16 {
+        let mut tight = [0; 39];
+        match pipe.server.send(&mut tight) {
+            Ok((written, info)) => {
+                saw_stream_credit |= process_paired_receive_credit_packet(
+                    &mut pipe,
+                    tight[..written].to_vec(),
+                    info,
+                    129 + R,
+                );
+            },
+
+            Err(Error::Done | Error::BufferTooShort) => break,
+
+            Err(e) => panic!("unexpected tight-buffer send error: {e:?}"),
+        }
+    }
+    if !saw_stream_credit {
+        loop {
+            let mut packet = [0; 128];
+            match pipe.server.send(&mut packet) {
+                Ok((written, info)) => {
+                    saw_stream_credit |= process_paired_receive_credit_packet(
+                        &mut pipe,
+                        packet[..written].to_vec(),
+                        info,
+                        129 + R,
+                    );
+                },
+
+                Err(Error::Done) => break,
+
+                Err(e) => {
+                    panic!("unexpected larger-buffer send error: {e:?}")
+                },
+            }
+        }
+    }
+    assert!(saw_stream_credit);
+
+    assert_eq!(pipe.client.stream_send(2, &[0x6b; 128], false), Ok(128));
+    assert_eq!(pipe.client.stream_send(0, b"x", false), Ok(1));
+}
+
+fn process_paired_receive_credit_packet(
+    pipe: &mut test_utils::Pipe, packet: Vec<u8>, info: SendInfo,
+    minimum_max_data: u64,
+) -> bool {
+    let mut saw_stream_credit = false;
+    let mut inspection = packet.clone();
+    let frames =
+        test_utils::decode_pkt(&mut pipe.client, &mut inspection).unwrap();
+    let has_stream_credit = frames.iter().any(|frame| {
+        matches!(
+            frame,
+            frame::Frame::MaxStreamData { .. } |
+                frame::Frame::MaxStreamsBidi { .. } |
+                frame::Frame::MaxStreamsUni { .. }
+        )
+    });
+    if has_stream_credit {
+        saw_stream_credit = true;
+        assert!(frames.iter().any(|frame| {
+            matches!(frame, frame::Frame::MaxData { max } if *max >= minimum_max_data)
+        }));
+    }
+    test_utils::process_flight(&mut pipe.client, vec![(packet, info)]).unwrap();
+    saw_stream_credit
+}
